<?xml version="1.0" encoding="utf-8"?>
<!-- Only the folder Tauri's camera capture writes into
     (getExternalFilesDir(DIRECTORY_PICTURES)): the FileProvider can't hand out
     a link to any other file. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <external-files-path name="my_images" path="Pictures/" />
</paths>
