{
  "name": "submarine",
  "version": "0.4.0",
  "description": "Free, open-source SSH and SFTP client with RDP, VNC and Telnet: terminal, dual-pane SFTP, port forwarding, folder mirror and encrypted profile sync for Windows, macOS, Linux and Android. Built with Rust and Tauri.",
  "keywords": [
    "ssh",
    "ssh-client",
    "sftp",
    "sftp-client",
    "telnet",
    "vnc",
    "rdp",
    "remote-desktop",
    "terminal",
    "port-forwarding",
    "ssh-tunnel",
    "socks5",
    "folder-sync",
    "ssh-agent",
    "tauri",
    "rust",
    "xterm",
    "android"
  ],
  "homepage": "https://sinaxhpm.com/submarine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinaxhpm/submarine.git"
  },
  "bugs": {
    "url": "https://github.com/sinaxhpm/submarine/issues"
  },
  "author": "Sina (https://sinaxhpm.com)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-dev.ps1",
    "android:dev:raw": "tauri android dev",
    "android:build:apk": "tauri android build --apk --target aarch64 armv7",
    "android:build": "npm run android:build:apk"
  },
  "dependencies": {
    "@fontsource/cascadia-code": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3"
  }
}
