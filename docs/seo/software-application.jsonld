    "@type": "Person",
    "name": "Sina",
    "url": "https://sinaxhpm.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "sinaxhpm",
    "url": "https://sinaxhpm.com"
  },
  "screenshot": [
    "https://raw.githubusercontent.com/sinaxhpm/submarine/main/docs/screenshots/hero.png",
    "https://raw.githubusercontent.com/sinaxhpm/submarine/main/docs/screenshots/compare.png",
    "https://raw.githubusercontent.com/sinaxhpm/submarine/main/docs/screenshots/wall.png",
    "https://raw.githubusercontent.com/sinaxhpm/submarine/main/docs/screenshots/vnc.png",
    "https://raw.githubusercontent.com/sinaxhpm/submarine/main/docs/screenshots/monitor.png",
    "https://raw.githubusercontent.com/sinaxhpm/submarine/main/docs/screenshots/servers-home-lab.png"
  ],
  "featureList": [
    "Tabbed SSH terminal (xterm.js) with colour schemes, split view, Wall pinboard and broadcast input",
    "Dual-pane SFTP file browser with folder compare, archive and extract, live edit and root mode through sudo",
    "SFTP over shell commands on servers that have no SFTP subsystem",
    "Local, remote and dynamic port forwarding",
    "SOCKS4 / SOCKS4a / SOCKS5 / SOCKS5h / HTTP CONNECT / HTTP proxy",
    "Two-way folder mirror with size and content-hash compare, live watcher and soft delete",
    "VNC viewer, RDP client (system RDP app or experimental built-in client) and Telnet",
    "Reads ~/.ssh/config: Include, Match, ProxyJump, ProxyCommand, IdentityFile, certificates",
    "ssh-agent, Pageant and Windows OpenSSH agent keys; OpenSSH and Teleport certificates",
    "TOFU host-key pinning with changed-key warnings",
    "Nested, colour-tagged server folders with drag and drop",
    "Import from PuTTY, MobaXterm, OpenSSH config and JSON",
    "Per-server notes and quick commands",
    "Server info panel and Docker manager",
    "Monitoring with CPU, memory, disk, load and network graphs and custom metrics",
    "Vault encrypted on disk with Argon2id and AES-256-GCM",
    "Optional quick unlock with Windows Hello or an Android fingerprint",
    "Optional cloud sync with client-side encryption of record contents, profile sharing and a self-hosted server option",
    "Native Rust and Tauri app, no bundled Chromium"
  ],
  "keywords": "ssh client, sftp client, telnet client, vnc viewer, rdp client, terminal, port forwarding, ssh tunnel, socks proxy, folder sync, ssh-agent, rust, tauri, putty alternative, winscp alternative, mobaxterm alternative, termius alternative, android ssh client",
  "sameAs": [
    "https://github.com/sinaxhpm/submarine"
  ]
}
